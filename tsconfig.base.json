{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Resolve the "development" condition in package.json imports/exports, so
    // typecheck and dev tooling read package sources; builds consume dist via
    // project references, which redirect referenced sources to declarations.
    "customConditions": ["development"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // No ambient @types are pulled in implicitly. Each package declares what it
    // needs (e.g. "types": ["node"]) so a browser package can never silently
    // typecheck against Node globals.
    "types": [],

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  }
}
