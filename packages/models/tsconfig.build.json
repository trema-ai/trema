{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo.build",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "#models/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../harness/tsconfig.build.json"
    }
  ]
}
