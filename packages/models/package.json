{
  "name": "@trema/models",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "imports": {
    "#models/*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "~5.0.32",
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/google-vertex": "5.0.31",
    "@ai-sdk/openai": "~4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@trema/harness": "workspace:*",
    "ai": "^7.0.31"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
