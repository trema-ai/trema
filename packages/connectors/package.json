{
  "name": "@trema/connectors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#connectors/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi-to-manifest": "tsx scripts/openapi-to-manifest.ts"
  },
  "dependencies": {
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsc-alias": "1.9.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
