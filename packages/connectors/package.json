{
  "name": "@trema/connectors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#connectors/*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi-to-manifest": "tsx --conditions=development scripts/openapi-to-manifest.ts"
  },
  "dependencies": {
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
