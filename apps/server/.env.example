NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trema
HOST=localhost
PORT=3000
TREMA_MODE=dedicated
TREMA_AUTH_SECRET=replace-with-at-least-32-random-characters
TREMA_AUTH_BASE_URL=http://localhost:3000
TREMA_WEB_ORIGINS=http://localhost:5173
TREMA_PASSWORD_AUTH_ENABLED=true

# A bootstrapped dedicated deployment creates accounts through invites only.
# Set this to true to accept account creation without an invite.
# TREMA_OPEN_SIGNUP=false

# Logs go to stderr, one record per line. Format: logfmt or json.
# Level: debug, info, warn, error, or silent.
TREMA_LOG_FORMAT=logfmt
TREMA_LOG_LEVEL=info

# Optional links shown in the sign-in footer. Omit either to hide it.
# TREMA_TERMS_URL=
# TREMA_PRIVACY_URL=

# Configure both values to enable Google sign-in.
# TREMA_GOOGLE_CLIENT_ID=
# TREMA_GOOGLE_CLIENT_SECRET=

# Optional dedicated-mode first-boot token. When omitted, one is generated and logged once.
# TREMA_BOOTSTRAP_TOKEN=

# The token budget for the standing context a session injects. Items past the
# budget stay reachable through search.
# TREMA_SESSION_STANDING_BUDGET_TOKENS=4000

# Required in dedicated mode. Generate with: openssl rand -base64 32
TREMA_CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Shutdown waits this long for acknowledged webhook deliveries to commit.
# TREMA_INGRESS_DRAIN_TIMEOUT_MS=30000

# Configure all three values together. OIDC wiring is a later plan step.
# TREMA_OIDC_ISSUER=
# TREMA_OIDC_CLIENT_ID=
# TREMA_OIDC_CLIENT_SECRET=

# Model configuration is control-plane data: the provider registry under
# /api/v1/model-providers owns it, and the admin API is how it changes. These
# three variables seed an organization whose registry is empty and are ignored
# from its first row onwards, which the server logs when it happens. They exist
# so an air-gapped first boot can start with an endpoint before anyone opens
# the UI.
# TREMA_MODEL_ENDPOINTS={"primary":{"protocol":"openai-compatible","baseUrl":"https://api.example.com/v1","apiKey":"..."}}
# The model the seeded `turns` role asks for, and the endpoint that serves it.
# The provider is optional when exactly one endpoint is configured.
# TREMA_MODEL_ID=
# TREMA_MODEL_PROVIDER=

# The workflow engine the run worker takes delivery from. Without a token the
# server starts, warns that run scheduling is off, and the runs endpoints
# report the feature unavailable. `mise run hatchet:up` (which `mise run dev`
# depends on) starts a local engine and appends these three for you.
# HATCHET_CLIENT_TOKEN=
# HATCHET_CLIENT_HOST_PORT=localhost:7077
# HATCHET_CLIENT_TLS_STRATEGY=none

# The run worker. Slots cap how many runs one worker executes at once; the drain
# timeout is how long a shutdown waits for the current turns before abandoning
# them (an abandoned turn was never committed, so it replays).
# TREMA_WORKER_NAME=trema-runs
# TREMA_WORKER_SLOTS=10
# TREMA_WORKER_DRAIN_TIMEOUT_MS=30000

# Hard cap on turns per run, and how long a blocking elicitation stays
# resolvable before the run goes stale.
# TREMA_RUN_MAX_TURNS=50
# TREMA_ELICITATION_TTL_MS=604800000
