NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trema
HOST=127.0.0.1
PORT=3000
TREMA_MODE=dedicated
TREMA_AUTH_SECRET=replace-with-at-least-32-random-characters
TREMA_AUTH_BASE_URL=http://127.0.0.1:3000
TREMA_WEB_ORIGINS=http://127.0.0.1:5173
TREMA_PASSWORD_AUTH_ENABLED=true

# Optional links shown in the sign-in footer. Omit either to hide it.
# TREMA_TERMS_URL=
# TREMA_PRIVACY_URL=

# Configure both values to enable Google sign-in.
# TREMA_GOOGLE_CLIENT_ID=
# TREMA_GOOGLE_CLIENT_SECRET=

# Optional dedicated-mode first-boot token. When omitted, one is generated and logged once.
# TREMA_BOOTSTRAP_TOKEN=

# Configure all three values together. OIDC wiring is a later plan step.
# TREMA_OIDC_ISSUER=
# TREMA_OIDC_CLIENT_ID=
# TREMA_OIDC_CLIENT_SECRET=
