    "/service-credentials": {
      "post": {
        "operationId": "serviceCredentials.create",
        "summary": "Create a service credential",
        "description": "Create an agent-bound service credential and return its secret once.",
        "tags": [
          "Service credentials"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A display name for the service credential. Cannot be empty."
                  }
                },
                "required": [
                  "name"
                ],
                "description": "The service credential to create."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The service credential's unique ID. A UUID (version 7)."
                    },
                    "name": {
                      "type": "string",
                      "description": "The display name used to identify the service credential."
                    },
                    "principalId": {
                      "type": "string",
                      "description": "The ID of the principal the service credential acts as. A UUID."
                    },
                    "createdAt": {
                      "type": "string",
                      "description": "When the service credential was created. An ISO 8601 date-time."
                    },
                    "revokedAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "When the service credential was revoked. Null while it remains active."
                    },
                    "secret": {
                      "type": "string",
                      "description": "The service credential secret. Store it now; it is returned only once."
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "principalId",
                    "createdAt",
                    "revokedAt",
                    "secret"
                  ],
                  "description": "The created service credential and its one-time secret."
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "serviceCredentials.list",
        "summary": "List service credentials",
        "description": "List service credential metadata for the active organization.",
        "tags": [
          "Service credentials"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
