{
  "name": "@trema/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "trema": "./dist/cli.js"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./types": {
      "types": "./src/public-types.ts"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "openapi": "tsx scripts/generate-openapi.ts",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@orpc/openapi": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@orpc/zod": "^1.14.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.2.3",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "catalog:",
    "prisma": "^7.8.0",
    "tsc-alias": "1.9.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
