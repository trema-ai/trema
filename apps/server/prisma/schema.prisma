generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  principals    Principal[]

  @@unique([email])
  @@map("user")
}

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model BootstrapToken {
  id        String   @id
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrincipalKind {
  human
  agent
}

enum ScopeKind {
  org
  shared
  personal
}

enum Role {
  owner
  admin
  member
  viewer
}

enum ItemKind {
  memory
  skill
  instruction
  connector
  conversation
}

enum ItemStatus {
  proposed
  active
  archived
}

enum ItemDisclosure {
  standing
  retrieved
}

enum ClientRegistrationSource {
  platform
  customer
  dynamic
}

/// The identity mode of a context session. It is a pure function of the scope
/// kind the session opens against: personal scopes delegate, everything else
/// acts as the organization's agent.
enum SessionMode {
  service
  delegated
}

/// Durable execution state of a run. `awaiting_approval` and `awaiting_input`
/// are first-class pause states: a parked run holds no worker and no lease.
enum RunState {
  queued
  running
  awaiting_approval
  awaiting_input
  completed
  failed
  cancelled
  stale
}

/// Why a run exists. The taxonomy is closed; every run carries one value and a
/// reference to the thing that produced it.
enum RunTrigger {
  message
  api
  schedule
  retry
  resume
}

/// Why a model turn ended.
enum TurnStopReason {
  stop
  toolUse
  length
  error
  aborted
  paused
}

/// Whether queued input waits for the next turn of an active run (`steering`)
/// or for the thread after the active run ends (`follow_up`).
enum RunInputKind {
  steering
  follow_up
}

enum ScheduleStatus {
  proposed
  active
  paused
  archived
}

/// What one evaluated cron tick did. Both skip outcomes exist so the count is
/// explainable: `overlap` found the schedule's thread still busy, `missed`
/// passed while nothing evaluated it.
enum ScheduleFiringOutcome {
  started
  skipped_overlap
  skipped_missed
}

model Org {
  id                        String                      @id @default(uuid(7))
  name                      String
  /// When false, DMs neither create nor resolve personal scopes.
  personalScopesEnabled     Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  principals                Principal[]
  identityLinks             IdentityLink[]
  scopes                    Scope[]
  grants                    Grant[]
  invites                   Invite[]
  serviceCredentials        ServiceCredential[]
  auditLogs                 AuditLog[]
  bindings                  Binding[]
  items                     Item[]
  itemVersions              ItemVersion[]
  clientRegistrations       ClientRegistration[]
  connectorConnections      ConnectorConnection[]
  connectorOAuthStates      ConnectorOAuthState[]
  connectorProviderSettings ConnectorProviderSettings[]
  contextSessions           ContextSession[]
  agentRuns                 AgentRun[]
  turns                     Turn[]
  runEvents                 RunEvent[]
  runQueuedInputs           RunQueuedInput[]
  runIntents                RunIntent[]
  runStops                  RunStop[]
  runElicitations           RunElicitation[]
  schedules                 Schedule[]
  scheduleFirings           ScheduleFiring[]
}

model Principal {
  id                        String                @id @default(uuid(7))
  orgId                     String
  kind                      PrincipalKind
  displayName               String
  authId                    String?
  email                     String?
  deactivatedAt             DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  org                       Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auth                      User?                 @relation(fields: [authId], references: [id], onDelete: SetNull)
  identityLinks             IdentityLink[]
  ownedScopes               Scope[]               @relation("ScopeOwner")
  grants                    Grant[]
  createdInvites            Invite[]              @relation("InviteCreator")
  redeemedInvites           Invite[]              @relation("InviteRedeemer")
  serviceCredentials        ServiceCredential[]   @relation("CredentialPrincipal")
  createdServiceCredentials ServiceCredential[]   @relation("CredentialCreator")
  auditLogs                 AuditLog[]            @relation("AuditActor")
  createdItems              Item[]                @relation("ItemCreator")
  confirmedItems            Item[]                @relation("ItemConfirmer")
  updatedItems              Item[]                @relation("ItemUpdater")
  authoredItemVersions      ItemVersion[]         @relation("ItemVersionAuthor")
  connectorConnections      ConnectorConnection[]
  connectorOAuthStates      ConnectorOAuthState[]
  actedContextSessions      ContextSession[]      @relation("ContextSessionActor")
  requestedContextSessions  ContextSession[]      @relation("ContextSessionRequester")
  createdSchedules          Schedule[]            @relation("ScheduleCreator")
  activatedSchedules        Schedule[]            @relation("ScheduleActivator")

  @@unique([orgId, authId])
  @@unique([orgId, id])
  @@index([authId])
  @@index([orgId, email])
}

model IdentityLink {
  id             String    @id @default(uuid(7))
  orgId          String
  surface        String
  externalUserId String
  principalId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal      Principal @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, surface, externalUserId])
  @@index([orgId, principalId])
}

/// Personal-scope uniqueness is enforced by the DB-level partial unique index
/// `Scope_one_personal_per_owner` on (orgId, ownerId) where kind = 'personal'.
model Scope {
  id        String     @id @default(uuid(7))
  orgId     String
  kind      ScopeKind
  name      String
  ownerId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     Principal? @relation("ScopeOwner", fields: [orgId, ownerId], references: [orgId, id], onDelete: Restrict)
  grants    Grant[]
  invites   Invite[]
  bindings  Binding[]
  items     Item[]
  sessions  ContextSession[]
  schedules Schedule[]

  @@unique([orgId, id])
  @@index([orgId, ownerId])
}

/// A context session: the handshake a harness opens before it reads context or
/// calls tools. Distinct from `Session`, which is a browser sign-in session.
/// The snapshot columns are pinned at open, so control-plane edits never alter
/// a running session.
model ContextSession {
  id                   String      @id @default(uuid(7))
  orgId                String
  scopeId              String
  surface              String
  locationRef          String
  threadRef            String?
  mode                 SessionMode
  /// Scope IDs in resolution order, widest first.
  scopeChain           String[]    @default([])
  actingPrincipalId    String
  requesterPrincipalId String?
  /// The raw surface id of a requester with no identity link.
  requesterExternalRef String?
  standing             Json
  policySnapshot       Json
  snapshotHash         String
  tokenHash            String      @unique
  expiresAt            DateTime
  closedAt             DateTime?
  usage                Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  org                  Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope                Scope       @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  actingPrincipal      Principal   @relation("ContextSessionActor", fields: [orgId, actingPrincipalId], references: [orgId, id], onDelete: Restrict)
  requesterPrincipal   Principal?  @relation("ContextSessionRequester", fields: [orgId, requesterPrincipalId], references: [orgId, id], onDelete: Restrict)
  agentRuns            AgentRun[]

  @@unique([orgId, id])
  @@index([orgId, scopeId])
  @@index([orgId, actingPrincipalId])
  @@index([orgId, requesterPrincipalId])
  @@index([orgId, expiresAt])
}

model Item {
  id              String         @id @default(uuid(7))
  orgId           String
  scopeId         String
  kind            ItemKind
  title           String
  body            Json
  status          ItemStatus
  disclosure      ItemDisclosure
  createdById     String
  sourceSessionId String?
  confirmedById   String?
  updatedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastUsedAt      DateTime?
  version         Int            @default(1)
  org             Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope           Scope          @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  createdBy       Principal      @relation("ItemCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)
  confirmedBy     Principal?     @relation("ItemConfirmer", fields: [orgId, confirmedById], references: [orgId, id], onDelete: Restrict)
  updatedBy       Principal?     @relation("ItemUpdater", fields: [orgId, updatedById], references: [orgId, id], onDelete: Restrict)
  versions        ItemVersion[]

  @@unique([orgId, id])
  @@index([orgId, scopeId])
  @@index([orgId, kind, status])
  @@index([orgId, createdById])
  @@index([orgId, confirmedById])
}

model ItemVersion {
  id        String     @id @default(uuid(7))
  orgId     String
  itemId    String
  version   Int
  title     String
  body      Json
  authorId  String?
  createdAt DateTime   @default(now())
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item      Item       @relation(fields: [orgId, itemId], references: [orgId, id], onDelete: Cascade)
  author    Principal? @relation("ItemVersionAuthor", fields: [orgId, authorId], references: [orgId, id], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([orgId, itemId])
}

model Binding {
  id          String   @id @default(uuid(7))
  orgId       String
  surface     String
  locationRef String
  scopeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope       Scope    @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, surface, locationRef])
  @@index([orgId, scopeId])
}

model Grant {
  id          String    @id @default(uuid(7))
  orgId       String
  principalId String
  role        Role
  scopeId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   Principal @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  scope       Scope     @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, principalId, scopeId])
  @@index([orgId, principalId])
  @@index([orgId, scopeId])
  @@map("grants")
}

model Invite {
  id           String     @id @default(uuid(7))
  orgId        String
  role         Role
  scopeId      String
  tokenHash    String     @unique
  expiresAt    DateTime
  redeemedAt   DateTime?
  revokedAt    DateTime?
  redeemedById String?
  createdById  String
  createdAt    DateTime   @default(now())
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope        Scope      @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  redeemedBy   Principal? @relation("InviteRedeemer", fields: [orgId, redeemedById], references: [orgId, id], onDelete: Restrict)
  createdBy    Principal  @relation("InviteCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, scopeId])
  @@index([orgId, redeemedById])
  @@index([orgId, createdById])
  @@index([orgId, expiresAt])
}

model ServiceCredential {
  id          String    @id @default(uuid(7))
  orgId       String
  principalId String
  name        String
  tokenHash   String    @unique
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   Principal @relation("CredentialPrincipal", fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  createdBy   Principal @relation("CredentialCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, principalId])
  @@index([orgId, createdById])
}

model AuditLog {
  id               String     @id @default(uuid(7))
  orgId            String
  actorPrincipalId String?
  action           String
  subject          String
  payload          Json
  createdAt        DateTime   @default(now())
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor            Principal? @relation("AuditActor", fields: [orgId, actorPrincipalId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, actorPrincipalId])
  @@index([orgId, createdAt])
}

model ClientRegistration {
  id                      String                   @id @default(uuid(7))
  orgId                   String
  providerKey             String
  source                  ClientRegistrationSource
  clientId                String?
  clientSecretCiphertext  String?
  tokenEndpointAuthMethod String?
  sharedRef               String?
  adminConsentGranted     Boolean?
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  org                     Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oauthStates             ConnectorOAuthState[]

  @@unique([orgId, providerKey, source])
  @@unique([orgId, id])
  @@index([orgId])
}

model ConnectorConnection {
  id                 String                @id @default(uuid(7))
  orgId              String
  providerKey        String
  principalId        String
  mode               String
  config             Json
  ciphertext         String
  providerScopes     String[]              @default([])
  label              String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  lastRefreshSuccess DateTime?
  lastRefreshFailure DateTime?
  refreshFailureStartedAt DateTime?
  refreshAttempts    Int                   @default(0)
  refreshExhausted   Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  org                Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal          Principal             @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  oauthStates        ConnectorOAuthState[]

  @@index([orgId, providerKey])
  @@index([orgId, principalId])
}

model ConnectorOAuthState {
  id             String               @id @default(uuid(7))
  orgId          String
  providerKey    String
  registrationId String
  connectionId   String?
  principalId    String
  stateHash      String               @unique
  codeVerifier   String
  config         Json
  label          String?
  providerScopes String[]             @default([])
  // mcp_oauth only: the token endpoint and RFC 8707 resource discovered before
  // the redirect, persisted so the callback can complete the exchange without
  // re-running discovery. Null for oauth2_code, whose token URL comes from the
  // provider catalog.
  tokenEndpoint  String?
  resource       String?
  returnTo       String?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  org            Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration   ClientRegistration   @relation(fields: [orgId, registrationId], references: [orgId, id], onDelete: Cascade)
  connection     ConnectorConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  principal      Principal            @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, registrationId])
  @@index([connectionId])
  @@index([orgId, principalId])
  @@index([expiresAt])
}

model ConnectorProviderSettings {
  id            String   @id @default(uuid(7))
  orgId         String
  providerKey   String
  memberEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, providerKey])
  @@index([orgId])
}

/// One agent run: the unit the workflow engine schedules and the harness owns.
/// The engine carries nothing but this row's id, so the record is here.
model AgentRun {
  id           String           @id
  orgId        String
  /// The conversation the run serializes against. One run per thread at a time.
  threadRef    String
  state        RunState
  trigger      RunTrigger
  turnCount    Int              @default(0)
  /// The highest event sequence number handed out for this run. An
  /// `UPDATE ... RETURNING` on this column allocates `seq` inside the same
  /// transaction as the event insert, which keeps the sequence dense.
  lastEventSeq Int              @default(0)
  sessionId    String?
  retryOfRunId String?
  /// One-based attempt number across a retry chain.
  retryAttempt Int?
  usage        Json?
  error        String?
  /// Tool names a principal approved for the remainder of this run.
  runGrants    String[]         @default([])
  /// Narrows the session's resolved tools for this run. It can never widen them.
  toolAllowlist String[]        @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  org          Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session      ContextSession?  @relation(fields: [orgId, sessionId], references: [orgId, id], onDelete: SetNull)
  retryOf      AgentRun?        @relation("AgentRunRetry", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries      AgentRun[]       @relation("AgentRunRetry")
  turns        Turn[]
  events       RunEvent[]
  queuedInputs RunQueuedInput[]
  elicitations RunElicitation[]
  stop         RunStop?
  firings      ScheduleFiring[]

  @@unique([orgId, id])
  @@index([orgId, threadRef, createdAt])
  @@index([orgId, state])
  @@index([orgId, sessionId])
  @@index([retryOfRunId])
}

/// One committed turn. A turn commits atomically at its end, so anything
/// mid-flight when a worker dies was never here and simply re-runs.
model Turn {
  orgId                String
  runId                String
  index                Int
  model                Json
  message              Json
  toolResults          Json
  /// Set while the turn waits on a gated tool call. Cleared when the approved
  /// call runs, which is what makes a paused turn resumable.
  pendingCallId        String?
  pendingElicitationId String?
  stopReason           TurnStopReason
  usage                Json
  createdAt            DateTime       @default(now())
  org                  Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run                  AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, index])
  @@index([orgId, runId])
}

/// One append-only run event. `seq` is dense within a run and assigned by the
/// server, never by a device or a sandbox.
model RunEvent {
  id      String   @id @default(uuid(7))
  orgId   String
  runId   String
  seq     Int
  at      DateTime
  /// Event envelope schema version.
  v       Int      @default(1)
  event   Json
  org     Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run     AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([orgId, runId, seq])
}

/// Input waiting for a turn boundary. Steering waits on a named run;
/// a follow-up waits on the thread and starts the next run.
model RunQueuedInput {
  id        String       @id
  orgId     String
  kind      RunInputKind
  runId     String?
  threadRef String
  message   Json
  author    Json
  /// Drain order. Timestamps alone tie under concurrent enqueues.
  position  Int          @default(autoincrement())
  createdAt DateTime     @default(now())
  org       Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run       AgentRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId, runId, position])
  @@index([orgId, threadRef, position])
}

/// A claimed intent or idempotency key. The insert is the claim: at-least-once
/// callers, exactly-once runs. The outcome is recorded so a duplicate call can
/// be answered with where the first one landed.
model RunIntent {
  id        String
  orgId     String
  runId     String?
  outcome   String?
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, createdAt])
}

/// The durable fact that a principal asked a run to stop. Its presence is what
/// separates a cancellation from worker death.
model RunStop {
  runId    String   @id
  orgId    String
  intentId String
  by       Json
  at       DateTime
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run      AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// A blocking elicitation and its single terminal resolution.
model RunElicitation {
  id         String    @id
  orgId      String
  runId      String
  event      Json
  expiresAt  DateTime?
  resolution Json?
  createdAt  DateTime  @default(now())
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run        AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([orgId, id])
  @@index([orgId, runId])
  @@index([orgId, expiresAt])
}

/// Standing execution config: a standing instruction to start runs. Knowledge
/// lives in the context app as items; a schedule produces executions, so it
/// lives with runs.
model Schedule {
  id            String           @id @default(uuid(7))
  orgId         String
  /// Sessions open here; the scope's binding names the surface location.
  scopeId       String
  /// Stable per schedule, so firings serialize against each other.
  threadRef     String
  cron          String
  /// IANA time zone. Daylight saving is resolved by the zone, not by UTC math.
  timezone      String
  /// The message each firing starts with.
  prompt        String
  /// Intersected with the session's resolved tools. Narrowing only.
  toolAllowlist String[]         @default([])
  status        ScheduleStatus   @default(proposed)
  createdById   String
  activatedById String?
  lastFiredAt   DateTime?
  /// The latest tick already evaluated, fired or skipped. Ticks before it are
  /// never made up.
  lastTickAt    DateTime?
  skippedCount  Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope         Scope            @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  createdBy     Principal        @relation("ScheduleCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)
  activatedBy   Principal?       @relation("ScheduleActivator", fields: [orgId, activatedById], references: [orgId, id], onDelete: Restrict)
  firings       ScheduleFiring[]

  @@unique([orgId, id])
  @@unique([orgId, threadRef])
  @@index([orgId, status])
  @@index([orgId, scopeId])
  @@index([orgId, createdById])
  @@index([orgId, activatedById])
}

/// One evaluated cron tick. A started firing points at its run; a skipped one
/// records why, which is what makes `skippedCount` explainable.
model ScheduleFiring {
  id         String                @id @default(uuid(7))
  orgId      String
  scheduleId String
  tickAt     DateTime
  outcome    ScheduleFiringOutcome
  runId      String?
  createdAt  DateTime              @default(now())
  org        Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  schedule   Schedule              @relation(fields: [orgId, scheduleId], references: [orgId, id], onDelete: Cascade)
  run        AgentRun?             @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([orgId, scheduleId, tickAt])
  @@index([orgId, scheduleId, tickAt])
  @@index([runId])
}
