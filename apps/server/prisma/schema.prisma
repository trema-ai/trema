generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  principals    Principal[]

  @@unique([email])
  @@map("user")
}

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model BootstrapToken {
  id        String   @id
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrincipalKind {
  human
  agent
}

enum ScopeKind {
  org
  shared
  personal
}

enum Role {
  owner
  admin
  member
  viewer
}

enum ItemKind {
  memory
  skill
  instruction
  connector
  conversation
}

enum ItemStatus {
  proposed
  active
  archived
}

enum ItemDisclosure {
  standing
  retrieved
}

enum ClientRegistrationSource {
  platform
  customer
  dynamic
}

model Org {
  id                        String                      @id @default(uuid(7))
  name                      String
  /// When false, DMs neither create nor resolve personal scopes.
  personalScopesEnabled     Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  principals                Principal[]
  identityLinks             IdentityLink[]
  scopes                    Scope[]
  grants                    Grant[]
  invites                   Invite[]
  serviceCredentials        ServiceCredential[]
  auditLogs                 AuditLog[]
  bindings                  Binding[]
  items                     Item[]
  itemVersions              ItemVersion[]
  clientRegistrations       ClientRegistration[]
  connectorConnections      ConnectorConnection[]
  connectorOAuthStates      ConnectorOAuthState[]
  connectorProviderSettings ConnectorProviderSettings[]
}

model Principal {
  id                        String                @id @default(uuid(7))
  orgId                     String
  kind                      PrincipalKind
  displayName               String
  authId                    String?
  email                     String?
  deactivatedAt             DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  org                       Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auth                      User?                 @relation(fields: [authId], references: [id], onDelete: SetNull)
  identityLinks             IdentityLink[]
  ownedScopes               Scope[]               @relation("ScopeOwner")
  grants                    Grant[]
  createdInvites            Invite[]              @relation("InviteCreator")
  redeemedInvites           Invite[]              @relation("InviteRedeemer")
  serviceCredentials        ServiceCredential[]   @relation("CredentialPrincipal")
  createdServiceCredentials ServiceCredential[]   @relation("CredentialCreator")
  auditLogs                 AuditLog[]            @relation("AuditActor")
  createdItems              Item[]                @relation("ItemCreator")
  confirmedItems            Item[]                @relation("ItemConfirmer")
  updatedItems              Item[]                @relation("ItemUpdater")
  authoredItemVersions      ItemVersion[]         @relation("ItemVersionAuthor")
  connectorConnections      ConnectorConnection[]
  connectorOAuthStates      ConnectorOAuthState[]

  @@unique([orgId, authId])
  @@unique([orgId, id])
  @@index([authId])
  @@index([orgId, email])
}

model IdentityLink {
  id             String    @id @default(uuid(7))
  orgId          String
  surface        String
  externalUserId String
  principalId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal      Principal @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, surface, externalUserId])
  @@index([orgId, principalId])
}

/// Personal-scope uniqueness is enforced by the DB-level partial unique index
/// `Scope_one_personal_per_owner` on (orgId, ownerId) where kind = 'personal'.
model Scope {
  id        String     @id @default(uuid(7))
  orgId     String
  kind      ScopeKind
  name      String
  ownerId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     Principal? @relation("ScopeOwner", fields: [orgId, ownerId], references: [orgId, id], onDelete: Restrict)
  grants    Grant[]
  invites   Invite[]
  bindings  Binding[]
  items     Item[]

  @@unique([orgId, id])
  @@index([orgId, ownerId])
}

model Item {
  id              String         @id @default(uuid(7))
  orgId           String
  scopeId         String
  kind            ItemKind
  title           String
  body            Json
  status          ItemStatus
  disclosure      ItemDisclosure
  createdById     String
  sourceSessionId String?
  confirmedById   String?
  updatedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastUsedAt      DateTime?
  version         Int            @default(1)
  org             Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope           Scope          @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  createdBy       Principal      @relation("ItemCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)
  confirmedBy     Principal?     @relation("ItemConfirmer", fields: [orgId, confirmedById], references: [orgId, id], onDelete: Restrict)
  updatedBy       Principal?     @relation("ItemUpdater", fields: [orgId, updatedById], references: [orgId, id], onDelete: Restrict)
  versions        ItemVersion[]

  @@unique([orgId, id])
  @@index([orgId, scopeId])
  @@index([orgId, kind, status])
  @@index([orgId, createdById])
  @@index([orgId, confirmedById])
}

model ItemVersion {
  id        String     @id @default(uuid(7))
  orgId     String
  itemId    String
  version   Int
  title     String
  body      Json
  authorId  String?
  createdAt DateTime   @default(now())
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item      Item       @relation(fields: [orgId, itemId], references: [orgId, id], onDelete: Cascade)
  author    Principal? @relation("ItemVersionAuthor", fields: [orgId, authorId], references: [orgId, id], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([orgId, itemId])
}

model Binding {
  id          String   @id @default(uuid(7))
  orgId       String
  surface     String
  locationRef String
  scopeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope       Scope    @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, surface, locationRef])
  @@index([orgId, scopeId])
}

model Grant {
  id          String    @id @default(uuid(7))
  orgId       String
  principalId String
  role        Role
  scopeId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   Principal @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  scope       Scope     @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, principalId, scopeId])
  @@index([orgId, principalId])
  @@index([orgId, scopeId])
  @@map("grants")
}

model Invite {
  id           String     @id @default(uuid(7))
  orgId        String
  role         Role
  scopeId      String
  tokenHash    String     @unique
  expiresAt    DateTime
  redeemedAt   DateTime?
  revokedAt    DateTime?
  redeemedById String?
  createdById  String
  createdAt    DateTime   @default(now())
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope        Scope      @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  redeemedBy   Principal? @relation("InviteRedeemer", fields: [orgId, redeemedById], references: [orgId, id], onDelete: Restrict)
  createdBy    Principal  @relation("InviteCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, scopeId])
  @@index([orgId, redeemedById])
  @@index([orgId, createdById])
  @@index([orgId, expiresAt])
}

model ServiceCredential {
  id          String    @id @default(uuid(7))
  orgId       String
  principalId String
  name        String
  tokenHash   String    @unique
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   Principal @relation("CredentialPrincipal", fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  createdBy   Principal @relation("CredentialCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, principalId])
  @@index([orgId, createdById])
}

model AuditLog {
  id               String     @id @default(uuid(7))
  orgId            String
  actorPrincipalId String?
  action           String
  subject          String
  payload          Json
  createdAt        DateTime   @default(now())
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor            Principal? @relation("AuditActor", fields: [orgId, actorPrincipalId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, actorPrincipalId])
  @@index([orgId, createdAt])
}

model ClientRegistration {
  id                      String                   @id @default(uuid(7))
  orgId                   String
  providerKey             String
  source                  ClientRegistrationSource
  clientId                String?
  clientSecretCiphertext  String?
  tokenEndpointAuthMethod String?
  sharedRef               String?
  adminConsentGranted     Boolean?
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  org                     Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oauthStates             ConnectorOAuthState[]

  @@unique([orgId, providerKey, source])
  @@unique([orgId, id])
  @@index([orgId])
}

model ConnectorConnection {
  id                 String                @id @default(uuid(7))
  orgId              String
  providerKey        String
  principalId        String
  mode               String
  config             Json
  ciphertext         String
  providerScopes     String[]              @default([])
  label              String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  lastRefreshSuccess DateTime?
  lastRefreshFailure DateTime?
  refreshAttempts    Int                   @default(0)
  refreshExhausted   Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  org                Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal          Principal             @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  oauthStates        ConnectorOAuthState[]

  @@index([orgId, providerKey])
  @@index([orgId, principalId])
}

model ConnectorOAuthState {
  id             String               @id @default(uuid(7))
  orgId          String
  providerKey    String
  registrationId String
  connectionId   String?
  principalId    String
  stateHash      String               @unique
  codeVerifier   String
  config         Json
  label          String?
  providerScopes String[]             @default([])
  // mcp_oauth only: the token endpoint and RFC 8707 resource discovered before
  // the redirect, persisted so the callback can complete the exchange without
  // re-running discovery. Null for oauth2_code, whose token URL comes from the
  // provider catalog.
  tokenEndpoint  String?
  resource       String?
  returnTo       String?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  org            Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration   ClientRegistration   @relation(fields: [orgId, registrationId], references: [orgId, id], onDelete: Cascade)
  connection     ConnectorConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  principal      Principal            @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, registrationId])
  @@index([connectionId])
  @@index([orgId, principalId])
  @@index([expiresAt])
}

model ConnectorProviderSettings {
  id            String   @id @default(uuid(7))
  orgId         String
  providerKey   String
  memberEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, providerKey])
  @@index([orgId])
}
