generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  principals    Principal[]

  @@unique([email])
  @@map("user")
}

model Session {
  id          String   @id
  expiresAt   DateTime
  token       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ipAddress   String?
  userAgent   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model BootstrapToken {
  id        String   @id
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrincipalKind {
  human
  agent
}

enum ScopeKind {
  org
  shared
  personal
}

enum Role {
  owner
  admin
  member
  viewer
}

/// The approval mode governing a session's connector calls. `ask` pauses every
/// call for a human; `delegated` executes and lets a call-time classifier
/// escalate unsafe calls; `full` executes ungated. Policies bound which of
/// these a human may choose — they never decide individual calls.
enum ApprovalMode {
  ask
  delegated
  full
}

/// Where a pending approval ended up. `expired` is a real outcome, not the
/// absence of one: an approval nobody answered is surfaced as expired rather
/// than quietly dropped.
enum ApprovalStatus {
  pending
  approved
  denied
  expired
}

enum ItemKind {
  memory
  skill
  instruction
  connector
  conversation
}

enum ItemStatus {
  proposed
  active
  archived
}

enum ItemDisclosure {
  standing
  retrieved
}

enum ClientRegistrationSource {
  platform
  customer
  dynamic
}

/// The identity mode of a context session. It is a pure function of the scope
/// kind the session opens against: personal scopes delegate, everything else
/// acts as the organization's agent.
enum SessionMode {
  service
  delegated
}

/// The wire protocol a model provider speaks. One member per protocol, never
/// per vendor: a vendor is a preset over a protocol, and a new protocol is a
/// new arm in `@trema/models`. Values are snake_case here and map to the
/// hyphenated descriptor literal in `services/model-providers`.
enum ModelProtocol {
  openai_compatible
  anthropic
  google
  openai_responses
  bedrock
  vertex
}

/// How a provider authenticates. `oauth` lands with the flow that implements
/// it; an unimplemented mode is not a value. `aws_sigv4` signs each request
/// with a stored key pair, or with whatever the worker's own role supplies
/// when the row stores none. `gcp_adc` mints a token from a stored service
/// account, or from whatever credential the worker itself can already reach.
enum ModelCredentialMode {
  api_key
  none
  aws_sigv4
  gcp_adc
}

/// What a model is asked to do. Each role resolves to its own provider and
/// model, so a deployment can run turns on one endpoint and embed on another.
enum ModelRole {
  turns
  utility
  embed
}

/// Durable execution state of a run. `awaiting_approval` and `awaiting_input`
/// are first-class pause states: a parked run holds no worker and no lease.
enum RunState {
  queued
  running
  awaiting_approval
  awaiting_input
  completed
  failed
  cancelled
  stale
}

/// Why a run exists. The taxonomy is closed; every run carries one value and a
/// reference to the thing that produced it.
enum RunTrigger {
  message
  api
  schedule
  retry
  resume
}

/// Why a model turn ended.
enum TurnStopReason {
  stop
  toolUse
  length
  error
  aborted
  paused
}

/// Whether queued input waits for the next turn of an active run (`steering`)
/// or for the thread after the active run ends (`follow_up`).
enum RunInputKind {
  steering
  follow_up
}

enum ScheduleStatus {
  proposed
  active
  paused
  archived
}

/// What one evaluated cron tick did. Both skip outcomes exist so the count is
/// explainable: `overlap` found the schedule's thread still busy, `missed`
/// passed while nothing evaluated it.
enum ScheduleFiringOutcome {
  started
  skipped_overlap
  skipped_missed
}

model Org {
  id                        String                      @id @default(uuid(7))
  name                      String
  /// When false, DMs neither create nor resolve personal scopes.
  personalScopesEnabled     Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  principals                Principal[]
  identityLinks             IdentityLink[]
  scopes                    Scope[]
  grants                    Grant[]
  policies                  Policy[]
  approvals                 Approval[]
  toolGrants                ToolGrant[]
  invites                   Invite[]
  serviceCredentials        ServiceCredential[]
  auditLogs                 AuditLog[]
  bindings                  Binding[]
  items                     Item[]
  itemVersions              ItemVersion[]
  clientRegistrations       ClientRegistration[]
  connectorConnections      ConnectorConnection[]
  connectorOAuthStates      ConnectorOAuthState[]
  connectorProviderSettings ConnectorProviderSettings[]
  modelProviders            ModelProvider[]
  modelDefaults             ModelDefault[]
  contextSessions           ContextSession[]
  conversations             Conversation[]
  messages                  Message[]
  agentRuns                 AgentRun[]
  turns                     Turn[]
  runEvents                 RunEvent[]
  runQueuedInputs           RunQueuedInput[]
  runIntents                RunIntent[]
  runStops                  RunStop[]
  runElicitations           RunElicitation[]
  schedules                 Schedule[]
  scheduleFirings           ScheduleFiring[]
}

model Principal {
  id                        String                @id @default(uuid(7))
  orgId                     String
  kind                      PrincipalKind
  displayName               String
  authId                    String?
  email                     String?
  deactivatedAt             DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  org                       Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auth                      User?                 @relation(fields: [authId], references: [id], onDelete: SetNull)
  identityLinks             IdentityLink[]
  ownedScopes               Scope[]               @relation("ScopeOwner")
  grants                    Grant[]
  createdInvites            Invite[]              @relation("InviteCreator")
  redeemedInvites           Invite[]              @relation("InviteRedeemer")
  serviceCredentials        ServiceCredential[]   @relation("CredentialPrincipal")
  createdServiceCredentials ServiceCredential[]   @relation("CredentialCreator")
  auditLogs                 AuditLog[]            @relation("AuditActor")
  createdItems              Item[]                @relation("ItemCreator")
  confirmedItems            Item[]                @relation("ItemConfirmer")
  updatedItems              Item[]                @relation("ItemUpdater")
  authoredItemVersions      ItemVersion[]         @relation("ItemVersionAuthor")
  connectorConnections      ConnectorConnection[]
  connectorOAuthStates      ConnectorOAuthState[]
  actedContextSessions      ContextSession[]      @relation("ContextSessionActor")
  requestedContextSessions  ContextSession[]      @relation("ContextSessionRequester")
  authoredMessages          Message[]             @relation("MessageAuthor")
  createdSchedules          Schedule[]            @relation("ScheduleCreator")
  activatedSchedules        Schedule[]            @relation("ScheduleActivator")
  requestedApprovals        Approval[]            @relation("ApprovalRequester")
  resolvedApprovals         Approval[]            @relation("ApprovalResolver")
  toolGrantsRequested       ToolGrant[]           @relation("ToolGrantRequester")
  toolGrantsCreated         ToolGrant[]           @relation("ToolGrantCreator")

  @@unique([orgId, authId])
  @@unique([orgId, id])
  @@index([authId])
  @@index([orgId, email])
}

model IdentityLink {
  id             String    @id @default(uuid(7))
  orgId          String
  surface        String
  externalUserId String
  principalId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal      Principal @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, surface, externalUserId])
  @@index([orgId, principalId])
}

/// Personal-scope uniqueness is enforced by the DB-level partial unique index
/// `Scope_one_personal_per_owner` on (orgId, ownerId) where kind = 'personal'.
model Scope {
  id            String           @id @default(uuid(7))
  orgId         String
  kind          ScopeKind
  name          String
  ownerId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner         Principal?       @relation("ScopeOwner", fields: [orgId, ownerId], references: [orgId, id], onDelete: Restrict)
  grants        Grant[]
  policies      Policy[]
  approvals     Approval[]
  toolGrants    ToolGrant[]
  invites       Invite[]
  bindings      Binding[]
  items         Item[]
  sessions      ContextSession[]
  conversations Conversation[]
  schedules     Schedule[]

  @@unique([orgId, id])
  @@index([orgId, ownerId])
}

/// A context session: the handshake a harness opens before it reads context or
/// calls tools. Distinct from `Session`, which is a browser sign-in session.
/// Standing context and policy are pinned at open. Connector discovery remains
/// live and is not stored on the session.
model ContextSession {
  id                   String       @id @default(uuid(7))
  orgId                String
  scopeId              String
  surface              String
  locationRef          String
  threadRef            String?
  mode                 SessionMode
  /// The approval mode the requester chose for this thread. The gate clamps it
  /// to the policy ceiling per call; this is the choice, never the outcome.
  approvalMode         ApprovalMode @default(ask)
  /// Scope IDs in resolution order, widest first.
  scopeChain           String[]     @default([])
  actingPrincipalId    String
  requesterPrincipalId String?
  /// The raw surface id of a requester with no identity link.
  requesterExternalRef String?
  standing             Json
  policySnapshot       Json
  snapshotHash         String
  tokenHash            String       @unique
  expiresAt            DateTime
  closedAt             DateTime?
  usage                Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  org                  Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope                Scope        @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  actingPrincipal      Principal    @relation("ContextSessionActor", fields: [orgId, actingPrincipalId], references: [orgId, id], onDelete: Restrict)
  requesterPrincipal   Principal?   @relation("ContextSessionRequester", fields: [orgId, requesterPrincipalId], references: [orgId, id], onDelete: Restrict)
  agentRuns            AgentRun[]
  approvals            Approval[]
  toolGrants           ToolGrant[]

  @@unique([orgId, id])
  @@index([orgId, scopeId])
  @@index([orgId, actingPrincipalId])
  @@index([orgId, requesterPrincipalId])
  @@index([orgId, expiresAt])
}

/// One captured thread, whatever surface it happened on. Identity is
/// `(surface, locationRef, threadRef)`, so repeated sessions on the same thread
/// extend one conversation instead of starting another.
///
/// A surface without threads — a direct message, a command-line run — reports
/// no `threadRef`, stored as the empty string. That keeps the key free of
/// nulls (Postgres treats nulls in a unique index as distinct), and no real
/// thread can collide with it: the session protocol refuses an empty
/// `threadRef`.
///
/// `scopeId` is the scope the session's binding resolved to. Rebinding the
/// location moves the conversation with it, because the binding is what decides
/// who may read the thread.
model Conversation {
  id             String    @id @default(uuid(7))
  orgId          String
  scopeId        String
  surface        String
  locationRef    String
  threadRef      String
  /// The people seen in the thread so far: `{ principalId }` for a linked
  /// person, `{ externalRef }` for a raw surface id.
  participants   Json      @default("[]")
  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope          Scope     @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  messages       Message[]

  @@unique([orgId, id])
  @@unique([orgId, surface, locationRef, threadRef])
  @@index([orgId, scopeId])
  @@index([orgId, lastActivityAt])
}

/// One captured message. `seq` orders the thread and is assigned per
/// conversation under a row lock, so concurrent batches never share a number.
/// `surfaceMessageRef` is the dedup key: reporting the same message again
/// updates it rather than adding a second copy.
model Message {
  id                String            @id @default(uuid(7))
  orgId             String
  conversationId    String
  seq               Int
  authorPrincipalId String?
  /// The raw surface id of an author with no identity link.
  authorExternalRef String?
  sentAt            DateTime
  text              String
  surfaceMessageRef String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  org               Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)
  author            Principal?        @relation("MessageAuthor", fields: [orgId, authorPrincipalId], references: [orgId, id], onDelete: Restrict)
  searchDoc         MessageSearchDoc?

  @@unique([orgId, id])
  @@unique([conversationId, seq])
  @@unique([conversationId, surfaceMessageRef])
  @@index([orgId, authorPrincipalId])
}

/// The search projection of a message. `tsv` is a generated column whose
/// expression Prisma cannot express, so the migration hand-writes it. The row
/// carries no scope: a transcript read joins `Conversation` for that, so moving
/// a conversation between scopes never rewrites the index.
///
/// The row is a replica of `Message.text` and is written after the message
/// lands, so a failed index write costs a search result, never a message.
model MessageSearchDoc {
  messageId String
  orgId     String
  text      String
  tsv       Unsupported("tsvector")?
  message   Message                  @relation(fields: [orgId, messageId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, messageId])
  @@index([tsv], type: Gin)
}

model Item {
  id                      String                   @id @default(uuid(7))
  orgId                   String
  scopeId                 String
  kind                    ItemKind
  title                   String
  body                    Json
  status                  ItemStatus
  disclosure              ItemDisclosure
  createdById             String
  sourceSessionId         String?
  confirmedById           String?
  updatedById             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastUsedAt              DateTime?
  version                 Int                      @default(1)
  org                     Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope                   Scope                    @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  createdBy               Principal                @relation("ItemCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)
  confirmedBy             Principal?               @relation("ItemConfirmer", fields: [orgId, confirmedById], references: [orgId, id], onDelete: Restrict)
  updatedBy               Principal?               @relation("ItemUpdater", fields: [orgId, updatedById], references: [orgId, id], onDelete: Restrict)
  versions                ItemVersion[]
  searchDoc               ItemSearchDoc?
  connectorToolSearchDocs ConnectorToolSearchDoc[]

  @@unique([orgId, id])
  @@index([orgId, scopeId])
  @@index([orgId, kind, status])
  @@index([orgId, createdById])
  @@index([orgId, confirmedById])
}

model ItemVersion {
  id        String     @id @default(uuid(7))
  orgId     String
  itemId    String
  version   Int
  title     String
  body      Json
  authorId  String?
  createdAt DateTime   @default(now())
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item      Item       @relation(fields: [orgId, itemId], references: [orgId, id], onDelete: Cascade)
  author    Principal? @relation("ItemVersionAuthor", fields: [orgId, authorId], references: [orgId, id], onDelete: Restrict)

  @@unique([itemId, version])
  @@index([orgId, itemId])
}

/// The search projection of an item. `tsv` is a generated column whose
/// expression Prisma cannot express, so the migration hand-writes it. The
/// row deliberately carries no scope or status: search joins `Item` for
/// those, so a lifecycle change never writes to this table.
///
/// `tsv` is built with the `trema_multilingual` configuration (`simple` plus
/// unaccent), which stems nothing and so treats every language alike. Queries
/// must parse with that same configuration or they stop matching what is
/// stored.
///
/// `embedding` declares no dimension. The dimension belongs to the model that
/// produced the vector, which `embeddingModel` records. Queries compare only
/// rows written by the organization's current model, so changing models is a
/// re-embed rather than a migration. There is deliberately no vector index:
/// every query is already narrowed to one organization's active items in a
/// few scopes, which exact search handles at this corpus size.
model ItemSearchDoc {
  itemId         String
  orgId          String
  title          String
  content        String
  tsv            Unsupported("tsvector")?
  embedding      Unsupported("vector")?
  embeddingModel String?
  item           Item                     @relation(fields: [orgId, itemId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, itemId])
  @@index([tsv], type: Gin)
}

/// Search projection for one enabled connector operation. The installation
/// remains the source of truth for schemas, status, scope, and execution.
model ConnectorToolSearchDoc {
  orgId              String
  installationItemId String
  providerKey        String
  toolName           String
  toolKey            String
  title              String
  content            String
  tsv                Unsupported("tsvector")?
  embedding          Unsupported("vector")?
  embeddingModel     String?
  installation       Item                     @relation(fields: [orgId, installationItemId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, installationItemId, toolName])
  @@index([orgId, providerKey])
  @@index([tsv], type: Gin)
}

/// One entry in an organization's model provider registry: an endpoint
/// descriptor plus the credential that reaches it. The environment seeds this
/// table on an empty registry and is ignored thereafter — these rows are the
/// configuration, and the admin API is how they change.
model ModelProvider {
  id                   String              @id @default(uuid(7))
  orgId                String
  /// The key role defaults reference. Stable, unique per organization.
  name                 String
  /// What the admin screen shows. Free text.
  label                String
  protocol             ModelProtocol
  baseUrl              String
  /// Extra headers sent with every request to this provider, or null for none.
  headersJson          Json?
  credentialMode       ModelCredentialMode @default(api_key)
  /// The envelope-encrypted credential. Written, never read back over the API.
  credentialCiphertext String?
  /// The provider's model list. Provider-shaped data, not rows anything
  /// queries; it becomes a table when a query needs one.
  catalogJson          Json?
  /// Query parameters the provider's own model-listing call carries, or null
  /// for none. Preset data: a listing that hides part of its catalog behind a
  /// filter is a vendor fact, and a vendor is a preset over a protocol.
  listQueryJson        Json?
  /// Protocol configuration that is neither address nor secret, or null where
  /// the protocol takes none. Each protocol declares the shape it accepts, and
  /// the ones that declare nothing refuse a value outright. `bedrock` needs a
  /// region: a signature names one whatever host answers the call, and it is
  /// read back, so it cannot ride the write-only credential. `vertex` needs a
  /// project and a location, which is where it addresses models.
  settingsJson         Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  org                  Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

/// The model one role resolves to, as an ordered fallback chain. No row for a
/// role means that role is unconfigured, which each consumer degrades on its
/// own terms.
model ModelDefault {
  id        String    @id @default(uuid(7))
  orgId     String
  role      ModelRole
  /// Ordered `{ providerName, modelId }` pairs. The first entry naming a
  /// provider that still exists wins; the rest are the fallback chain.
  chainJson Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, role])
  @@index([orgId])
}

model Binding {
  id          String   @id @default(uuid(7))
  orgId       String
  surface     String
  locationRef String
  scopeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope       Scope    @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, surface, locationRef])
  @@index([orgId, scopeId])
}

model Grant {
  id          String    @id @default(uuid(7))
  orgId       String
  principalId String
  role        Role
  scopeId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   Principal @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  scope       Scope     @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, principalId, scopeId])
  @@index([orgId, principalId])
  @@index([orgId, scopeId])
  @@map("grants")
}

/// An approval policy bounds what humans may choose, per scope and optionally
/// per connector: the loosest approval mode selectable there, and who may
/// resolve the interrupts that pause there. The effective ceiling for a call
/// is the most restrictive `maxMode` across the scope chain and the
/// connector's rows; absent any row, trusted catalog entries cap at
/// `delegated`, untrusted entries pin to `ask`, and `full` is reachable only
/// through an explicit row.
model Policy {
  id                     String       @id @default(uuid(7))
  orgId                  String
  scopeId                String
  /// The connector catalog key the row governs; null bounds every connector in the scope.
  connectorKey           String?
  maxMode                ApprovalMode
  /// The roles that may resolve an interrupt routed by this row.
  approverRoles          Role[]       @default([])
  /// Whether the person who asked may approve their own action.
  allowRequesterApproval Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  org                    Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope                  Scope        @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)

  // A scope holds at most one row per connector and one scope-wide row: the
  // partial unique indexes Policy_org_scope_connector_key and
  // Policy_org_scope_default_key, maintained in SQL because Prisma cannot
  // express partial unique indexes.
  @@unique([orgId, id])
  @@index([orgId, scopeId])
}

/// One gated call waiting on a human, and how it ended.
///
/// The row is self-contained on purpose. `argsJson` is the call verbatim and
/// `argsHash` is its fingerprint, so execution can prove it runs exactly what
/// was approved. `approverRoles` and `allowRequesterApproval` are copied from
/// the session's pinned policy snapshot at request time, so who may resolve the
/// approval is fixed when it is asked — a policy edited while it waits reaches
/// the next session, never this pending decision.
///
/// `executedAt` is the at-most-once claim: an executor takes it with a
/// compare-and-swap against null, and the loser of a race never runs the call.
model Approval {
  id                     String         @id @default(uuid(7))
  orgId                  String
  sessionId              String
  /// The session's scope. Approver roles are read here, never at the org scope.
  scopeId                String
  toolKey                String
  /// The call's arguments, recorded verbatim. An approval covers these and nothing else.
  argsJson               Json
  /// SHA-256 of the canonical form of `argsJson`. Exact-args binding compares this.
  argsHash               String
  /// The model's one-line justification, rendered to the approver.
  reason                 String
  /// The approval mode the call ran under when it paused: `ask` pauses every
  /// call, `delegated` pauses the calls its classifier escalates.
  mode                   ApprovalMode
  /// The classifier's one-line reason for pausing a delegated-mode call.
  escalationReason       String?
  /// The roles that may resolve this approval, copied from the pinned snapshot.
  approverRoles          Role[]         @default([])
  /// Whether the person who asked may resolve it, copied from the pinned snapshot.
  allowRequesterApproval Boolean        @default(false)
  requesterPrincipalId   String?
  /// The raw surface id of a requester with no identity link.
  requesterExternalRef   String?
  /// What the approved call will run against, recorded when the approval is asked and compared when it is claimed. Null for approvals that bind nothing, such as `context:activate_item`.
  executionBinding       Json?
  status                 ApprovalStatus @default(pending)
  expiresAt              DateTime
  /// When the re-nudge job last re-surfaced this approval.
  nudgedAt               DateTime?
  nudgeCount             Int            @default(0)
  resolvedById           String?
  resolvedAt             DateTime?
  executedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  org                    Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session                ContextSession @relation(fields: [orgId, sessionId], references: [orgId, id], onDelete: Cascade)
  scope                  Scope          @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  requesterPrincipal     Principal?     @relation("ApprovalRequester", fields: [orgId, requesterPrincipalId], references: [orgId, id], onDelete: Restrict)
  resolvedBy             Principal?     @relation("ApprovalResolver", fields: [orgId, resolvedById], references: [orgId, id], onDelete: Restrict)
  toolGrants             ToolGrant[]

  @@unique([orgId, id])
  @@index([orgId, status, expiresAt])
  @@index([orgId, scopeId, status])
  @@index([orgId, sessionId])
  @@index([orgId, requesterPrincipalId])
  @@index([orgId, resolvedById])
  // A session holds at most one pending approval per call: the partial unique
  // index Approval_one_pending_per_session_call, maintained in SQL because
  // Prisma does not model partial uniques, is what makes the re-ask dedup in
  // `services/approvals` hold under concurrent asks.
  @@index([orgId, sessionId, toolKey, argsHash])
}

/// A human's wider consent for one connector tool, minted when an approval is
/// resolved with the `run` or `always` variant. A row naming a session covers
/// that thread and dies with it; a row naming no session is a standing,
/// admin-visible exemption and lives until revoked. The approval gate reads
/// these before pausing a call; nothing else creates them.
model ToolGrant {
  id                   String          @id @default(uuid(7))
  orgId                String
  scopeId              String
  toolKey              String
  /// The session (thread) the grant covers; null is a standing grant.
  sessionId            String?
  /// The requester the grant covers. A standing grant always names one.
  requesterPrincipalId String?
  /// The approval whose resolution minted this grant.
  sourceApprovalId     String
  /// The human who resolved that approval.
  createdById          String
  createdAt            DateTime        @default(now())
  revokedAt            DateTime?
  org                  Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope                Scope           @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  session              ContextSession? @relation(fields: [orgId, sessionId], references: [orgId, id], onDelete: Cascade)
  requesterPrincipal   Principal?      @relation("ToolGrantRequester", fields: [orgId, requesterPrincipalId], references: [orgId, id], onDelete: Cascade)
  sourceApproval       Approval        @relation(fields: [orgId, sourceApprovalId], references: [orgId, id], onDelete: Cascade)
  createdBy            Principal       @relation("ToolGrantCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, id])
  @@index([orgId, sessionId, toolKey])
  @@index([orgId, scopeId, toolKey])
}

model Invite {
  id           String     @id @default(uuid(7))
  orgId        String
  role         Role
  scopeId      String
  tokenHash    String     @unique
  expiresAt    DateTime
  redeemedAt   DateTime?
  revokedAt    DateTime?
  redeemedById String?
  createdById  String
  createdAt    DateTime   @default(now())
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope        Scope      @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  redeemedBy   Principal? @relation("InviteRedeemer", fields: [orgId, redeemedById], references: [orgId, id], onDelete: Restrict)
  createdBy    Principal  @relation("InviteCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, scopeId])
  @@index([orgId, redeemedById])
  @@index([orgId, createdById])
  @@index([orgId, expiresAt])
}

model ServiceCredential {
  id          String    @id @default(uuid(7))
  orgId       String
  principalId String
  name        String
  tokenHash   String    @unique
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   Principal @relation("CredentialPrincipal", fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  createdBy   Principal @relation("CredentialCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, principalId])
  @@index([orgId, createdById])
}

model AuditLog {
  id               String     @id @default(uuid(7))
  orgId            String
  actorPrincipalId String?
  action           String
  subject          String
  payload          Json
  createdAt        DateTime   @default(now())
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor            Principal? @relation("AuditActor", fields: [orgId, actorPrincipalId], references: [orgId, id], onDelete: Restrict)

  @@index([orgId, actorPrincipalId])
  @@index([orgId, createdAt])
}

model ClientRegistration {
  id                      String                   @id @default(uuid(7))
  orgId                   String
  providerKey             String
  source                  ClientRegistrationSource
  clientId                String?
  clientSecretCiphertext  String?
  tokenEndpointAuthMethod String?
  sharedRef               String?
  adminConsentGranted     Boolean?
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  org                     Org                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  oauthStates             ConnectorOAuthState[]

  @@unique([orgId, providerKey, source])
  @@unique([orgId, id])
  @@index([orgId])
}

model ConnectorConnection {
  id                      String                @id @default(uuid(7))
  orgId                   String
  providerKey             String
  principalId             String
  mode                    String
  config                  Json
  ciphertext              String
  providerScopes          String[]              @default([])
  label                   String?
  expiresAt               DateTime?
  revokedAt               DateTime?
  lastRefreshSuccess      DateTime?
  lastRefreshFailure      DateTime?
  refreshFailureStartedAt DateTime?
  refreshAttempts         Int                   @default(0)
  refreshExhausted        Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  org                     Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal               Principal             @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)
  oauthStates             ConnectorOAuthState[]

  @@index([orgId, providerKey])
  @@index([orgId, principalId])
}

model ConnectorOAuthState {
  id             String               @id @default(uuid(7))
  orgId          String
  providerKey    String
  registrationId String
  connectionId   String?
  principalId    String
  stateHash      String               @unique
  codeVerifier   String
  config         Json
  label          String?
  providerScopes String[]             @default([])
  // mcp_oauth only: the token endpoint and RFC 8707 resource discovered before
  // the redirect, persisted so the callback can complete the exchange without
  // re-running discovery. Null for oauth2_code, whose token URL comes from the
  // provider catalog.
  tokenEndpoint  String?
  resource       String?
  returnTo       String?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  org            Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registration   ClientRegistration   @relation(fields: [orgId, registrationId], references: [orgId, id], onDelete: Cascade)
  connection     ConnectorConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  principal      Principal            @relation(fields: [orgId, principalId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, registrationId])
  @@index([connectionId])
  @@index([orgId, principalId])
  @@index([expiresAt])
}

model ConnectorProviderSettings {
  id            String   @id @default(uuid(7))
  orgId         String
  providerKey   String
  memberEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, providerKey])
  @@index([orgId])
}

/// One agent run: the unit the workflow engine schedules and the harness owns.
/// The engine carries nothing but this row's id, so the record is here.
model AgentRun {
  id                String           @id
  orgId             String
  /// The conversation the run serializes against. One run per thread at a time.
  threadRef         String
  state             RunState
  trigger           RunTrigger
  turnCount         Int              @default(0)
  /// The highest event sequence number handed out for this run. An
  /// `UPDATE ... RETURNING` on this column allocates `seq` inside the same
  /// transaction as the event insert, which keeps the sequence dense.
  lastEventSeq      Int              @default(0)
  sessionId         String?
  retryOfRunId      String?
  /// One-based attempt number across a retry chain.
  retryAttempt      Int?
  usage             Json?
  error             String?
  /// Tool names a principal approved for the remainder of this run.
  runGrants         String[]         @default([])
  /// Narrows the session's resolved tools for this run. It can never widen them.
  toolAllowlist     String[]         @default([])
  /// The provider explicitly selected for this run. Null follows the turns role.
  modelProviderName String?
  /// The provider-specific model explicitly selected for this run.
  modelModelId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  org               Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// NoAction, not SetNull: SET NULL on a compound key would null `orgId` too,
  /// and run visibility is pinned to the session's grant snapshot, so the
  /// session row must outlive its runs. NO ACTION checks at end of statement,
  /// which lets an org delete cascade both sides while refusing any delete
  /// that would leave a surviving run without its session.
  session           ContextSession?  @relation(fields: [orgId, sessionId], references: [orgId, id], onDelete: NoAction)
  retryOf           AgentRun?        @relation("AgentRunRetry", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries           AgentRun[]       @relation("AgentRunRetry")
  turns             Turn[]
  events            RunEvent[]
  queuedInputs      RunQueuedInput[]
  elicitations      RunElicitation[]
  stop              RunStop?
  firings           ScheduleFiring[]

  @@unique([orgId, id])
  @@index([orgId, threadRef, createdAt])
  @@index([orgId, state])
  @@index([orgId, sessionId])
  @@index([retryOfRunId])
}

/// One committed turn. A turn commits atomically at its end, so anything
/// mid-flight when a worker dies was never here and simply re-runs.
model Turn {
  orgId                String
  runId                String
  index                Int
  model                Json
  /// Steering and follow-ups drained just before this turn's model call. A
  /// resumed execution replays the model context from committed turns, so the
  /// turn that consumed the input is where the input is recorded.
  input                Json           @default("[]")
  message              Json
  toolResults          Json
  /// Set while the turn waits on a gated tool call. Cleared when the approved
  /// call runs, which is what makes a paused turn resumable.
  pendingCallId        String?
  pendingElicitationId String?
  stopReason           TurnStopReason
  usage                Json
  createdAt            DateTime       @default(now())
  org                  Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run                  AgentRun       @relation(fields: [orgId, runId], references: [orgId, id], onDelete: Cascade)

  @@id([runId, index])
  @@index([orgId, runId])
}

/// One append-only run event. `seq` is dense within a run and assigned by the
/// server, never by a device or a sandbox.
model RunEvent {
  id    String   @id @default(uuid(7))
  orgId String
  runId String
  seq   Int
  at    DateTime
  /// Event envelope schema version.
  v     Int      @default(1)
  event Json
  org   Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run   AgentRun @relation(fields: [orgId, runId], references: [orgId, id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([orgId, runId, seq])
}

/// Input waiting for a turn boundary. Steering waits on a named run;
/// a follow-up waits on the thread and starts the next run.
model RunQueuedInput {
  id                String       @id
  orgId             String
  kind              RunInputKind
  runId             String?
  threadRef         String
  message           Json
  author            Json
  /// The provider selected for the run this input eventually starts.
  modelProviderName String?
  /// The provider-specific model selected for the run this input eventually starts.
  modelModelId      String?
  /// Drain order. Timestamps alone tie under concurrent enqueues.
  position          Int          @default(autoincrement())
  createdAt         DateTime     @default(now())
  org               Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run               AgentRun?    @relation(fields: [orgId, runId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, runId, position])
  @@index([orgId, threadRef, position])
}

/// A claimed intent or idempotency key. The insert is the claim: at-least-once
/// callers, exactly-once runs. The outcome is recorded so a duplicate call can
/// be answered with where the first one landed.
model RunIntent {
  id        String
  orgId     String
  runId     String?
  outcome   String?
  /// The intent kind the claim was made for. A reuse of the id with a
  /// different kind or target is a mismatch to refuse, never a replay.
  kind      String?
  /// The run or elicitation the claimed intent addressed, when it had one.
  targetId  String?
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, createdAt])
}

/// The durable fact that a principal asked a run to stop. Its presence is what
/// separates a cancellation from worker death.
model RunStop {
  runId    String   @id
  orgId    String
  intentId String
  by       Json
  at       DateTime
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run      AgentRun @relation(fields: [orgId, runId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, runId])
  @@index([orgId])
}

/// A blocking elicitation and its single terminal resolution.
model RunElicitation {
  id         String    @id
  orgId      String
  runId      String
  event      Json
  expiresAt  DateTime?
  resolution Json?
  createdAt  DateTime  @default(now())
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run        AgentRun  @relation(fields: [orgId, runId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id])
  @@index([orgId, runId])
  @@index([orgId, expiresAt])
}

/// Standing execution config: a standing instruction to start runs. Knowledge
/// lives in the context app as items; a schedule produces executions, so it
/// lives with runs.
model Schedule {
  id            String           @id @default(uuid(7))
  orgId         String
  /// Sessions open here; the scope's binding names the surface location.
  scopeId       String
  /// Stable per schedule, so firings serialize against each other.
  threadRef     String
  cron          String
  /// IANA time zone. Daylight saving is resolved by the zone, not by UTC math.
  timezone      String
  /// The message each firing starts with.
  prompt        String
  /// Intersected with the session's resolved tools. Narrowing only.
  toolAllowlist String[]         @default([])
  status        ScheduleStatus   @default(proposed)
  createdById   String
  activatedById String?
  lastFiredAt   DateTime?
  /// The latest tick already evaluated, fired or skipped. Ticks before it are
  /// never made up.
  lastTickAt    DateTime?
  skippedCount  Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scope         Scope            @relation(fields: [orgId, scopeId], references: [orgId, id], onDelete: Cascade)
  createdBy     Principal        @relation("ScheduleCreator", fields: [orgId, createdById], references: [orgId, id], onDelete: Restrict)
  activatedBy   Principal?       @relation("ScheduleActivator", fields: [orgId, activatedById], references: [orgId, id], onDelete: Restrict)
  firings       ScheduleFiring[]

  @@unique([orgId, id])
  @@unique([orgId, threadRef])
  @@index([orgId, status])
  @@index([orgId, scopeId])
  @@index([orgId, createdById])
  @@index([orgId, activatedById])
}

/// One evaluated cron tick. A started firing points at its run; a skipped one
/// records why, which is what makes `skippedCount` explainable.
model ScheduleFiring {
  id         String                @id @default(uuid(7))
  orgId      String
  scheduleId String
  tickAt     DateTime
  outcome    ScheduleFiringOutcome
  runId      String?
  createdAt  DateTime              @default(now())
  org        Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  schedule   Schedule              @relation(fields: [orgId, scheduleId], references: [orgId, id], onDelete: Cascade)
  run        AgentRun?             @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([orgId, scheduleId, tickAt])
  @@index([orgId, scheduleId, tickAt])
  @@index([runId])
}
